---
// src/layouts/Layout.astro
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} | Navi's Book Tracker</title>
    <!-- Inline script to prevent theme flashing on load -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
  </head>
  <body>
    <nav class="navbar">
      <div class="nav-content">
        <a href="/" class="brand"> Navi's [📖] Tracker</a>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/books">Books</a>
          <a href="/history">History & Stats</a>
          <a href="/entry" class="btn-nav">+ Log Reading</a>
          <button id="themeToggleBtn" type="button" class="theme-toggle-btn" aria-label="Toggle theme">🌙</button>
        </div>
      </div>
    </nav>
    
    <div class="page-wrapper">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="footer-content">
        <a href="https://pomnavi.net" target="_blank" rel="noopener noreferrer">pomnavi.net</a>
      </div>
    </footer>

    <script is:inline>
      const toggleBtn = document.getElementById('themeToggleBtn');
      const htmlEl = document.documentElement;

      // Set initial button icon based on current theme
      if (toggleBtn) {
        toggleBtn.textContent = htmlEl.getAttribute('data-theme') === 'dark' ? '☀️' : '🌙';
        
        toggleBtn.addEventListener('click', () => {
          const currentTheme = htmlEl.getAttribute('data-theme');
          const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
          
          htmlEl.setAttribute('data-theme', newTheme);
          localStorage.setItem('theme', newTheme);
          toggleBtn.textContent = newTheme === 'dark' ? '☀️' : '🌙';
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f8fafc;
    --card-bg: #ffffff;
    --text: #0f172a;
    --primary: #4f46e5;
    --border: #e2e8f0;
    --heading-text: #0f172a;
    --table-bg: #fdfdfd;
  }

  [data-theme='dark'] {
    --bg: #0f172a;
    --card-bg: #1e293b;
    --text: #f8fafc;
    --primary: #6366f1;
    --border: #334155;
    --heading-text: #f8fafc;
    --table-bg: #1e293b;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  
  html, body {
    height: 100%;
    background-color: var(--bg);
    color: var(--text);
    transition: background-color 0.2s ease, color 0.2s ease;
    overflow-x: hidden;
  }

  body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
    display: flex;
    flex-direction: column;
  }

  .page-wrapper {
    flex: 1;
  }

  /* Style main headings and section headers */
  h1:not(.book-card h1):not(.card h1),
  h2:not(.book-card h2):not(.book-summary-header h2):not(.card h2),
  h3:not(.book-card h3):not(.book-summary-header h3):not(.card h3) {
    color: var(--heading-text);
  }

  .navbar {
    background: var(--card-bg);
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 0;
    margin-bottom: 2rem;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .nav-content {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .brand { font-weight: 700; text-decoration: none; color: var(--text); font-size: 1.1rem; }
  .nav-links { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  .nav-links a { text-decoration: none; color: var(--text); font-weight: 500; font-size: 0.9rem; }
  .nav-links a:hover { color: var(--primary); }
  .btn-nav { background: var(--primary); color: white !important; padding: 0.35rem 0.7rem; border-radius: 6px; }

  /* Theme Toggle Button Styling */
  .theme-toggle-btn {
    background: var(--border);
    border: none;
    cursor: pointer;
    font-size: 0.9rem;
    padding: 0.3rem 0.45rem;
    border-radius: 6px;
    transition: background 0.2s ease;
  }
  .theme-toggle-btn:hover {
    opacity: 0.85;
  }

  /* Mobile responsiveness tightening */
  @media (max-width: 768px) {
    .nav-content {
      justify-content: center;
      text-align: center;
    }
    .nav-links {
      justify-content: center;
      gap: 0.75rem;
    }
  }

  /* Minimal & Cute Footer Styling */
  .site-footer {
    padding: 2.5rem 0 2rem 0;
    text-align: center;
  }

  .site-footer a {
    color: #94a3b8;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.025em;
    padding: 0.3rem 0.6rem;
    border-radius: 9999px;
    transition: all 0.2s ease;
  }

  .site-footer a:hover {
    color: var(--primary);
    background: #e0e7ff33;
  }
</style>
